.DS_Store

# Секреты (токен, пароли, сгенерированные ключи)
config.ini
*.session_secret
.session_secret
data/.*
data/*.json
data/*.lock

# Данные (выгрузка AD, обработанные реестры)
ad_export.json
data/ad_export.json
data/registry_processed.json
data/processed/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Логи
*.log

# front_site: заявки на передачу, контроль, добавление и загруженные сканы
front_site/data/*.json
!front_site/data/.gitkeep
front_site/uploads/
front_site/logs/

# Снимки кода перед миграцией (копии не коммитим; README — да)
migration_code_backup/*
!migration_code_backup/README.txt
